# =============================================================================
# LA PASADITA API - Local env template (docker-compose.local.yml)
# =============================================================================
# Committed template with local-only dummy values. Copy to `.env` (gitignored,
# auto-loaded by Docker Compose from the project root) and the stack boots
# without extra setup:
#   cp .env.example .env
# Replace values only if you need real integrations (Facturapi, R2).
# =============================================================================

# Local frontend origin(s), comma-separated. Leave empty to keep the prod
# default (https://lapasadita.app)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Must be valid base64 (TokenJwtConfig base64-decodes it). Generate your own:
#   openssl rand -base64 48
JWT_SECRET=eVO2Haco7YPJHSjjPfHLLxouCMLBHsb/FuhzFIswF4ORe5EuyB0LurPvCK4TrRTm
JWT_EXPIRATION=86400000

# CSD (SAT certificate) — dummies are fine unless testing real CFDI stamping
CSD_CER_PATH=/tmp/dummy.cer
CSD_KEY_PATH=/tmp/dummy.key
CSD_PASSWORD=dummy

# Facturapi secret bearer token — dummy is fine unless stamping real invoices
FACTURAPI_KEY=sk_test_dummy

# Cloudflare R2 — S3Client bean is built eagerly at startup, so R2_ENDPOINT
# must be a valid URI even with dummy credentials
R2_ACCESS_KEY=dummy
R2_SECRET_KEY=dummy
R2_ENDPOINT=https://dummy.r2.cloudflarestorage.com
R2_BUCKET=lapasadita-assets
R2_PUBLIC_URL=https://assets.example.com
