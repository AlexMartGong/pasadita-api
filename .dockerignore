# Build output — keep only the bootable JAR (the Dockerfile is runtime-only)
target/
!target/pasadita-api-*.jar

# IDEs
.idea/
.vscode/
*.iml

# Git / CI
.git/
.github/
.gitignore
.gitattributes

# Logs
*.log
logs/

# Environment files
.env
.env.*

# OS temp files
.DS_Store
Thumbs.db
*.swp
*~

# Repo extras not needed for the build
.claude/
.agents/
*.md
qodana.yaml
skills-lock.json
mvnw.cmd

# CSD certificates (fiscal secrets) — mounted as a volume in prod,
# never baked into the image
certificados/

# Source tree — not needed: the image copies the prebuilt JAR from target/
src/
.mvn/
mvnw
pom.xml
